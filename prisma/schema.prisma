/// Car tags (admin-manageable): Single Owner, Accident-Free, GCC Spec, ...
model CarTagOption {
  id        String       @id @default(cuid())
  title     String       @unique
  image     String?
  listings  CarListing[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("car_tag_options")
}

/// Car body type (admin-manageable): SUV, Sedan, Hatchback, Coupe, Pickup, Van, ...
model CarTypeOption {
  id        String       @id @default(cuid())
  title     String       @unique
  listings  CarListing[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("car_type_options")
}

/// Car model (admin-manageable): Camry, Corolla, Land Cruiser, Civic, ...
model CarModelOption {
  id        String       @id @default(cuid())
  title     String       @unique
  image     String?
  listings  CarListing[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("car_model_options")
}

/// Car brand (admin-manageable): Toyota, Honda, Nissan, ... "Popular brands" shown on the home page
/// are the ones flagged `isPopular`.
model CarBrandOption {
  id        String       @id @default(cuid())
  name      String       @unique
  image     String?
  isPopular Boolean      @default(false)
  isActive  Boolean      @default(true)
  listings  CarListing[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("car_brand_options")
