// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  MODERATOR
  DEALER
  DEALER_STAFF
  USER
}

enum AuthProvider {
  LOCAL
  GOOGLE
  APPLE
  WHATSAPP_OTP
}

/// Granular permissions assignable to MODERATOR accounts (SUPER_ADMIN bypasses all checks).
/// Mirrors the admin panel's permission model 1:1 so the frontend's permission keys and the
/// backend's @RequirePermissions() checks stay in lockstep.
enum Permission {
  // Dashboard
  DASHBOARD_VIEW

  // Car Listings
  CARS_VIEW
  CARS_MANAGE
  CARS_REVIEW

  // Car Analytics
  CAR_ANALYTICS_VIEW

  // Listing Payment Settings
  LISTING_SETTINGS_VIEW
  LISTING_SETTINGS_MANAGE

  // Dealers
  DEALERS_VIEW
  DEALERS_MANAGE
  DEALERS_APPLICATIONS_REVIEW

  // Dealer Analytics
  DEALER_ANALYTICS_VIEW

  // Featured Plans
  FEATURED_PLANS_VIEW
  FEATURED_PLANS_MANAGE

  // Featured Cars
  FEATURED_CARS_VIEW

  // Subscription Plans
  SUBSCRIPTION_PLANS_VIEW
  SUBSCRIPTION_PLANS_MANAGE

  // Dealer Subscriptions
  DEALER_SUBSCRIPTIONS_VIEW

  // Users
  USERS_VIEW

  // Moderators
  MODERATORS_VIEW
  MODERATORS_MANAGE

  // Options (Car Brands, Car Models, Car Types, Car Features, Car Tags)
  OPTIONS_VIEW
  OPTIONS_MANAGE

  // Banners
  BANNERS_VIEW
  BANNERS_MANAGE

  // Support
  SUPPORT_VIEW
  SUPPORT_REPLY
  SUPPORT_UPDATE_STATUS
}

/// Permissions assignable to dealer staff members
enum DealerStaffPermission {
  DASHBOARD_VIEW
  CAR_LISTINGS_VIEW
  CAR_DETAILS_VIEW
  CAR_EDIT
  CAR_ADD
  CAR_FEATURE
  CAR_MARK_SOLD
  CAR_PAYMENT
  STAFF_VIEW
  STAFF_ADD
  STAFF_EDIT
  STAFF_DELETE
  VISIT_INQUIRIES_VIEW
  BULK_UPLOAD
  ANALYTICS_VIEW
  SUBSCRIPTION_VIEW
  SUBSCRIPTION_PURCHASE
  SUBSCRIPTION_RENEW
  INVOICES_VIEW
  CHATS_MANAGE
}

enum ListingPurpose {
  SALE
  RENT
}

enum ListingStatus {
  /// Awaiting admin/moderator review
  PENDING
  ACTIVE
  INACTIVE
  REJECTED
  RESUBMITTED
  SOLD
  /// Content already approved by admin/moderator but outside the free-listing quota —
  /// held here until payment succeeds, then moves straight to ACTIVE (no further review).
  PENDING_PAYMENT
}

enum ListingReviewAction {
  SUBMITTED
  APPROVED
  REJECTED
  RESUBMITTED
  EDITED_BY_ADMIN
  FLAGGED_DUPLICATE
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  RESUBMITTED
}

enum DocumentType {
  TRADE_LICENSE
  ID_CARD
  PASSPORT
  BUSINESS_REGISTRATION
  RERA_CERTIFICATE
  OTHER
}

enum MessageType {
  TEXT
  IMAGE
  LOCATION
}

enum TicketCategory {
  REPORT_LISTING
  REPORT_USER
  PAYMENT
  GENERAL
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  ATTENDED
  CLOSED
}

enum VisitStatus {
  PENDING
  ACCEPTED
  RESCHEDULED
  REJECTED
  CANCELLED
}

/// Placement locations where featured listings appear
enum FeaturedPlacementLocation {
  HOME_PAGE
  LISTING_PAGE
  CAR_DETAIL_PAGE
}

enum TrackingLogType {
  IMPRESSION
  VIEW
  /// User tapped "Chat on WhatsApp" for a listing (logged client-side)
  WHATSAPP_CLICK
}

/// Duration tier for a featured plan
enum FeaturedPlanDuration {
  SEVEN_DAYS
  TWENTY_DAYS
  THIRTY_DAYS
}

/// Stripe payment lifecycle for a featured subscription
enum FeaturedPaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  FREE
}

/// Payment lifecycle for a dealer agency subscription plan
enum DealerSubPaymentStatus {
  PENDING
  PAID
  FREE
  FAILED
}

/// Payment lifecycle for a single listing creation
enum ListingPaymentStatus {
  PENDING
  PAID
  FREE
  FAILED
}

/// Which billable action an Invoice documents — kept common across the three
/// payable flows in the app so all invoices share one shape/API.
enum InvoiceType {
  LISTING_PAYMENT
  FEATURED_LISTING
  DEALER_SUBSCRIPTION
}

/// Whether the invoiced amount was actually charged (Stripe) or covered by
/// free quota / a 100% discount / an admin-assigned grant.
enum InvoiceStatus {
  PAID
  FREE
}

/// Gearbox type of a car listing
enum TransmissionType {
  AUTOMATIC
  MANUAL
}

/// Fuel type of a car listing
enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
}

/// Condition of a car listing
enum CarCondition {
  NEW
  USED
}

// ─────────────────────────────────────────────────────────────────────────────
// Car Features & Car Tag constants are stored as String[] via relations below.
// The allowed values are enforced in the application layer (DTOs / service),
// backed by the admin-manageable option tables (CarFeatureOption, CarTagOption).
//
// CAR FEATURES (examples, admin-manageable):
//   Sunroof, Leather Seats, Navigation System, Bluetooth, Cruise Control,
//   Backup Camera, Alloy Wheels, Keyless Entry, Parking Sensors, Heated Seats,
//   Third Row Seating, Apple CarPlay / Android Auto, Lane Assist,
//   Blind Spot Monitor, Ventilated Seats, Panoramic Roof, Premium Sound System
//
// CAR TAGS (examples, admin-manageable):
//   Single Owner, Accident-Free, GCC Spec, Under Warranty, Certified Pre-Owned,
//   Imported, Full Service History, No Paint Work, Agency Maintained
// ─────────────────────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id                String       @id @default(cuid())
  name              String?
  email             String?      @unique
  phone             String?      @unique
  password          String?
  role              UserRole     @default(USER)
  authProvider      AuthProvider @default(LOCAL)
  googleId          String?      @unique
  appleId           String?      @unique
  isProfileComplete Boolean      @default(false)
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  /// Number of free listings this (non-dealer) user has already used, counted against
  /// the admin-configured `USER_FREE_LISTINGS_LIMIT` system setting
  freeListingsUsed Int @default(0)

  moderatorProfile   ModeratorProfile?   @relation("ModeratorUser")
  createdModerators  ModeratorProfile[]  @relation("CreatedByAdmin")
  carListings        CarListing[]
  carListingReviews  CarListingReview[]
  dealerProfile      DealerProfile?
  dealerApplication  DealerApplication?  @relation("ApprovedDealerUser")
  applicationReviews ApplicationReview[]

  // Chat relations
  dealerStaffOwner   DealerStaff[]      @relation("DealerStaffOwner")
  dealerStaffMember  DealerStaff?       @relation("DealerStaffMember")
  chatConversations  ChatConversation[] @relation("ConversationUser")
  chatParticipations ChatParticipant[]  @relation("ConversationParticipant")
  sentMessages       ChatMessage[]      @relation("MessageSender")

  // Support ticket relations
  submittedTickets  SupportTicket[] @relation("TicketSubmitter")
  reportedInTickets SupportTicket[] @relation("ReportedUser")
  assignedTickets   SupportTicket[] @relation("TicketAssignee")
  ticketReplies     TicketReply[]   @relation("TicketReplyAuthor")

  // Wishlist and Visits relations
  wishlists       Wishlist[]
  visitsAsVisitor CarVisit[] @relation("VisitVisitor")
  visitsAsOwner   CarVisit[] @relation("VisitOwner")

  // Featured listing relations
  featuredBoostsAdded FeaturedSubscription[] @relation("AdminFeaturedBoosts")
  featuredBoostsOwned FeaturedSubscription[] @relation("UserFeaturedBoosts")

  // Dealer subscription relations
  dealerSubscriptions         DealerSubscription[] @relation("DealerSubscriptions")
  assignedDealerSubscriptions DealerSubscription[] @relation("AssignedDealerSubscriptions")

  // Invoice relations
  invoices Invoice[] @relation("InvoicesBilledTo")

  // Push notification relations
  deviceTokens  DeviceToken[]
  notifications Notification[]

  // Bulk listing upload draft relations
  listingDraftsAsAgency   CarListingDraft[] @relation("ListingDraftAgency")
  listingDraftsAsUploader CarListingDraft[] @relation("ListingDraftUploader")

  @@map("users")
}

/// Platform a registered FCM device token belongs to
enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

/// A Firebase Cloud Messaging token registered by a user's device, for push notifications.
/// One user can have several (multiple devices); one token belongs to exactly one user at a time —
/// re-registering an existing token on a different account reassigns it (device logged into a new account).
model DeviceToken {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String          @unique
  platform  DevicePlatform?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([userId])
  @@map("device_tokens")
}

/// In-app notification feed entry, created alongside every push notification sent via
/// NotificationsService (see sendToUser/sendToUsers) so account holders — dealers and
/// dealer staff in particular — have a persistent, mark-as-read notification list even if
/// they never registered a device / push delivery failed.
model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title String
  body  String
  /// Optional machine-readable event type (e.g. "LISTING_APPROVED") for client-side routing
  type  String?
  /// Extra key/value data delivered alongside the notification (deep-link route, entity IDs, ...)
  data  Json?

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

/// OTP records for the email-based "forgot password" flow (SUPER_ADMIN / MODERATOR /
/// DEALER / DEALER_STAFF — the same roles allowed to use email+password login).
model PasswordResetOtp {
  id        String   @id @default(cuid())
  email     String
  otp       String
  expiresAt DateTime
  verified  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@map("password_reset_otps")
}

model ModeratorProfile {
  id          String       @id @default(cuid())
  userId      String       @unique
  user        User         @relation("ModeratorUser", fields: [userId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User         @relation("CreatedByAdmin", fields: [createdById], references: [id])
  permissions Permission[]
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("moderator_profiles")
}

model DealerProfile {
  id           String  @id @default(cuid())
  userId       String  @unique
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  dealerName   String
  contactPhone String?
  tagline      String?
  coverImage   String?
  /// Agency logo / profile picture (distinct from the cover/hero banner image)
  logoImage    String?
  tradeNumber  String?
  reraNumber   String?
  address      String?
  city         String?
  country      String  @default("Saudi Arabia")
  website      String?
  description  String?
  facebook     String?
  youtube      String?
  whatsapp     String?
  instagram    String?

  availableFreeListings           Int       @default(0)
  availableFreeFeatured           Int       @default(0)
  subscriptionValidUntil          DateTime?
  currentListingDiscountPercent   Float     @default(0)
  currentFeaturingDiscountPercent Float     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("dealer_profiles")
}

model DealerApplication {
  id           String @id @default(cuid())
  submissionId String @unique

  dealerName  String
  contactName String 
  email       String
  phone       String

  tradeNumber        String?
  reraNumber         String?
  address            String?
  city               String?
  country            String  @default("Saudi Arabia")
  website            String?
  description        String?
  additionalContacts Json?

  status      ApplicationStatus @default(DRAFT)
  currentStep Int               @default(1)

  editToken       String?   @unique
  editTokenExpiry DateTime?

  dealerUserId String? @unique
  dealerUser   User?   @relation("ApprovedDealerUser", fields: [dealerUserId], references: [id])

  documents DealerDocument[]
  reviews   ApplicationReview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("dealer_applications")
}

model DealerDocument {
  id            String            @id @default(cuid())
  applicationId String
  application   DealerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  documentType  DocumentType
  originalName  String
  minioKey      String
  mimeType      String?
  sizeBytes     Int?
  uploadedAt    DateTime          @default(now())

  @@map("dealer_documents")
}

model ApplicationReview {
  id            String            @id @default(cuid())
  applicationId String
  application   DealerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  action        String
  message       String?
  reviewedById  String
  reviewedBy    User              @relation(fields: [reviewedById], references: [id])
  reviewedAt    DateTime          @default(now())

  @@map("application_reviews")
}

// ─────────────────────────────────────────────────────────────────────────────
// Car Listing (enhanced)
// ─────────────────────────────────────────────────────────────────────────────

model CarListing {
  id String @id @default(cuid())

  // ── Core ──────────────────────────────────────────────────────────────────
  title         String
  referenceCode String?           @unique
  slug          String?           @unique
  description   String?
  purpose       ListingPurpose    @default(SALE)
  modelId       String
  model         CarModelOption    @relation(fields: [modelId], references: [id])
  brandId       String
  brand         CarBrandOption    @relation(fields: [brandId], references: [id])

  // ── GPS & Spam Detection ──────────────────────────────────────────────────
  latitude             Float?
  longitude            Float?
  /// Flagged when another listing with same title exists within 50 m
  isPotentialDuplicate Boolean @default(false)
  /// CUID of the suspected original listing (set by service during spam check)
  duplicateOfId        String?

  // ── Common Car Details ────────────────────────────────────────────────────
  modelYear       Int?
  mileage         Float? // km driven
  transmission    TransmissionType?
  fuelType        FuelType?
  condition       CarCondition      @default(USED)
  exteriorColor   String?
  interiorColor   String?
  cylinders       Int?
  doors           Int?
  /// Vehicle Identification Number
  vin             String?           @unique
  carTypeId       String?
  carType         CarTypeOption?    @relation(fields: [carTypeId], references: [id])

  // ── Body-Type-Specific Extra Properties (stored as JSON) ──────────────────
  /// SUV extras: driveType(2WD/4WD/AWD), seatingCapacity(int), groundClearanceMm(float)
  /// Sedan extras: trunkCapacityLiters(float)
  /// Pickup extras: bedLengthMeters(float), towingCapacityKg(float)
  /// Van extras: seatingCapacity(int), cargoVolumeLiters(float)
  /// Convertible extras: roofType(string)
  /// Electric/Hybrid extras: batteryRangeKm(float), chargeTimeHours(float)
  extraProperties Json?

  // ── Price ─────────────────────────────────────────────────────────────────
  price           Float
  priceNegotiable Boolean @default(false)

  // ── Saudi Arabia Address ───────────────────────────────────────────────────
  addressLine1   String?
  addressLine2   String?
  areaName       String? // e.g. "Al Olaya", "King Fahd Road", "Jeddah Corniche"
  country        String  @default("Saudi Arabia")

  // ── Contact ───────────────────────────────────────────────────────────────
  contactPhone    String?
  contactWhatsapp String?
  contactVerified Boolean @default(false)

  // ── Features & Tags ───────────────────────────────────────────────────────
  features      CarFeatureOption[]
  tags          CarTagOption[]
  /// Free-text additional info
  otherFeatures String?

  // ── Workflow ──────────────────────────────────────────────────────────────
  status          ListingStatus        @default(PENDING)
  submissionCount Int                  @default(1)
  paymentStatus   ListingPaymentStatus @default(FREE)
  stripeSessionId String?              @unique
  /// Standalone PaymentIntent created alongside the Checkout Session, for mobile native payment
  /// (Checkout Session's own PaymentIntent isn't reliably available until payment completes)
  stripePaymentIntentId String? @unique
  /// Amount actually charged for a pay-per-listing submission (SAR), set once Stripe confirms payment
  paidAmount      Float?
  /// Timestamp the listing was marked SOLD (used for admin sales analytics)
  soldAt          DateTime?

  // ── Relations ─────────────────────────────────────────────────────────────
  createdById           String
  createdBy             User                   @relation(fields: [createdById], references: [id])
  photos                CarListingPhoto[]
  reviews               CarListingReview[]
  conversations         ChatConversation[]
  wishlistedBy          Wishlist[]
  visits                CarVisit[]
  featuredSubscriptions FeaturedSubscription[]
  trackingLogs          CarListingTrackingLog[]
  /// Set if this listing was created from a bulk-upload draft
  sourceDraft           CarListingDraft?

  impressionsCount    Int @default(0)
  viewsCount          Int @default(0)
  reachCount          Int @default(0)
  /// Number of times a user tapped "Chat on WhatsApp" for this listing
  whatsappClicksCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("car_listings")
}

model CarListingTrackingLog {
  id        String          @id @default(cuid())
  listingId String
  listing   CarListing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  deviceId  String
  type      TrackingLogType
  createdAt DateTime        @default(now())

  @@index([listingId, deviceId, type, createdAt])
  @@map("car_listing_tracking_logs")
}

/// Individual photo with sort order for a listing
model CarListingPhoto {
  id         String     @id @default(cuid())
  listingId  String
  listing    CarListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url        String
  minioKey   String?
  caption    String?
  sortOrder  Int        @default(0)
  uploadedAt DateTime   @default(now())

  @@map("car_listing_photos")
}

/// Full audit trail — every approve / reject / resubmit / admin-edit action
model CarListingReview {
  id           String              @id @default(cuid())
  listingId    String
  listing      CarListing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  action       ListingReviewAction
  /// Human-readable note (rejection reason, moderator note, etc.)
  message      String?
  /// Snapshot of listing data at time of action (for super admin history)
  snapshot     Json?
  reviewedById String?
  reviewedBy   User?               @relation(fields: [reviewedById], references: [id])
  reviewedAt   DateTime            @default(now())

  @@map("car_listing_reviews")
}

// ─────────────────────────────────────────────────────────────────────────────
// Dealer Bulk Car Listing Upload (JSON / Excel / CSV → draft rows for review)
// ─────────────────────────────────────────────────────────────────────────────

enum CarListingDraftSource {
  JSON
  EXCEL
  CSV
}

enum CarListingDraftStatus {
  /// Parsed and stored, not yet turned into a real listing
  PENDING
  /// Consumed by POST /listings (draftId) — a real CarListing now exists
  USED
  /// Dealer discarded it without creating a listing
  DISCARDED
}

/// One row from a dealer's bulk JSON/Excel/CSV upload, held here for review/editing
/// before being turned into a real CarListing via POST /listings { draftId }.
model CarListingDraft {
  id String @id @default(cuid())

  /// Groups every row from a single upload together
  batchId   String
  source    CarListingDraftSource
  /// 1-indexed row position in the uploaded file (for the dealer to locate/fix it)
  rowNumber Int

  /// The dealer agency this draft belongs to (always the dealer, even if a staff member uploaded it)
  dealerUserId String
  dealerUser   User   @relation("ListingDraftAgency", fields: [dealerUserId], references: [id], onDelete: Cascade)
  /// The actual uploader (dealer or dealer staff)
  createdById  String
  createdBy    User   @relation("ListingDraftUploader", fields: [createdById], references: [id])

  status CarListingDraftStatus @default(PENDING)
  /// Parsed row, shaped like CreateListingDto (title, purpose, modelId, brandId, price, photos[], ...)
  data   Json
  /// Validation problems found at parse time (missing required fields, unresolvable model/brand, etc.)
  /// Empty array = row parsed cleanly. Dealers can still submit — server re-validates at creation time.
  errors Json?

  /// Set once this draft has been turned into a real listing
  listingId String?     @unique
  listing   CarListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dealerUserId, status])
  @@index([batchId])
  @@map("car_listing_drafts")
}

model OtpRecord {
  id        String   @id @default(cuid())
  phone     String
  otp       String
  expiresAt DateTime
  verified  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@map("otp_records")
}

// ─────────────────────────────────────────────────────────────────────────────
// Chat / Messaging
// ─────────────────────────────────────────────────────────────────────────────

/// Links DEALER_STAFF users to their parent DEALER user
model DealerStaff {
  id           String                  @id @default(cuid())
  dealerUserId String
  staffUserId  String                  @unique
  /// Display name / position inside the agency
  position     String?
  /// Permissions granted to this staff member by the dealer
  permissions  DealerStaffPermission[]
  isActive     Boolean                 @default(true)
  dealerUser   User                    @relation("DealerStaffOwner", fields: [dealerUserId], references: [id], onDelete: Cascade)
  staffUser    User                    @relation("DealerStaffMember", fields: [staffUserId], references: [id], onDelete: Cascade)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@map("dealer_staff")
}

/// One conversation per (enquiring user + listing).
/// Participants = enquiring user + listing owner (createdBy) + dealer + all dealer staff.
model ChatConversation {
  id        String     @id @default(cuid())
  listingId String
  listing   CarListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation("ConversationUser", fields: [userId], references: [id])
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  messages     ChatMessage[]
  participants ChatParticipant[]

  @@unique([listingId, userId])
  @@map("chat_conversations")
}

/// Tracks every participant in a conversation
model ChatParticipant {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation("ConversationParticipant", fields: [userId], references: [id])
  joinedAt       DateTime         @default(now())

  @@unique([conversationId, userId])
  @@map("chat_participants")
}

/// Individual message in a conversation
model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User             @relation("MessageSender", fields: [senderId], references: [id])
  type           MessageType      @default(TEXT)
  /// Text body (for TEXT type)
  content        String?
  /// MinIO URL (for IMAGE type)
  mediaUrl       String?
  /// Latitude (for LOCATION type)
  latitude       Float?
  /// Longitude (for LOCATION type)
  longitude      Float?
  /// Human-readable location label (for LOCATION type)
  locationLabel  String?
  createdAt      DateTime         @default(now())

  @@map("chat_messages")
}

// ─────────────────────────────────────────────────────────────────────────────
// Support Tickets
// ─────────────────────────────────────────────────────────────────────────────

/// A support ticket raised by any authenticated user or dealer.
model SupportTicket {
  id String @id @default(cuid())

  /// The user who raised the ticket
  submitterId String
  submitter   User   @relation("TicketSubmitter", fields: [submitterId], references: [id])

  category TicketCategory
  subject  String
  message  String         @db.Text
  status   TicketStatus   @default(OPEN)

  /// For REPORT_LISTING — the listing being reported (optional reference, not a FK constraint)
  listingId String?

  /// For REPORT_USER — the user being reported
  reportedUserId String?
  reportedUser   User?   @relation("ReportedUser", fields: [reportedUserId], references: [id])

  /// Moderator / admin assigned to handle this ticket
  assignedToId String?
  assignedTo   User?   @relation("TicketAssignee", fields: [assignedToId], references: [id])

  replies TicketReply[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("support_tickets")
}

/// A reply message on a support ticket (by admin or user)
model TicketReply {
  id       String        @id @default(cuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("TicketReplyAuthor", fields: [authorId], references: [id])

  message String  @db.Text
  /// true = reply from admin/moderator, false = reply from ticket submitter
  isAdmin Boolean @default(false)

  createdAt DateTime @default(now())

  @@map("ticket_replies")
}

// ─────────────────────────────────────────────────────────────────────────────
// Wishlists
// ─────────────────────────────────────────────────────────────────────────────

model Wishlist {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   CarListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([userId, listingId])
  @@map("wishlists")
}

// ─────────────────────────────────────────────────────────────────────────────
// Car Visits (test drive / viewing appointments)
// ─────────────────────────────────────────────────────────────────────────────

model CarVisit {
  id        String     @id @default(cuid())
  listingId String
  listing   CarListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  visitorId String
  visitor   User       @relation("VisitVisitor", fields: [visitorId], references: [id], onDelete: Cascade)
  ownerId   String
  owner     User       @relation("VisitOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  scheduledAt DateTime
  proposedAt  DateTime? // For reconfirmation
  status      VisitStatus @default(PENDING)
  notes       String?     @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("car_visits")
}

// ─────────────────────────────────────────────────────────────────────────────
// Featured Listings
// ─────────────────────────────────────────────────────────────────────────────

/// Admin-configured plan that defines where and how long a car listing is featured
model FeaturedPlan {
  id           String                      @id @default(cuid())
  name         String // e.g. "7-Day Multi-Location Boost"
  /// One or more placement locations included in this plan
  locations    FeaturedPlacementLocation[]
  duration     FeaturedPlanDuration
  durationDays Int // 7, 20, or 30
  price        Float // in SAR
  isActive     Boolean                     @default(true)
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt

  subscriptions FeaturedSubscription[]

  @@map("featured_plans")
}

/// A listing that has been boosted using a featured plan
model FeaturedSubscription {
  id        String       @id @default(cuid())
  listingId String
  listing   CarListing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  planId    String
  plan      FeaturedPlan @relation(fields: [planId], references: [id])

  /// Denormalised for fast filtering by location without joining
  location FeaturedPlacementLocation

  startDate DateTime
  endDate   DateTime

  paymentStatus         FeaturedPaymentStatus @default(PENDING)
  stripePaymentIntentId String?
  stripeSessionId       String?               @unique
  paidAmount            Float?
  /// Discount % applied from dealer's active subscription plan
  discountApplied       Float?

  /// Null = self-service by listing owner; set when admin adds directly
  addedByAdminId String?
  addedByAdmin   User?   @relation("AdminFeaturedBoosts", fields: [addedByAdminId], references: [id])

  createdById String
  createdBy   User   @relation("UserFeaturedBoosts", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("featured_subscriptions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Dynamic Options
// ─────────────────────────────────────────────────────────────────────────────

