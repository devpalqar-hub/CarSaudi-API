// ─────────────────────────────────────────────────────────────────────────────
// Dealer Subscription Plans
// ─────────────────────────────────────────────────────────────────────────────

/// Super-admin-configured agency plan for dealers (controls listing quota + boost discount)
model DealerSubscriptionPlan {
  id           String @id @default(cuid())
  name         String // e.g. "Gold Agency Plan"
  /// Max number of active listings allowed under this plan (0 = unlimited)
  maxListings  Int    @default(0)
  /// Plan validity in days
  validityDays Int
  /// Price in QAR (0 = free plan)
  price        Float  @default(0)

  /// Number of free listings granted instantly upon purchase
  freeListings           Int   @default(0)
  /// Number of free featured listings granted instantly upon purchase
  freeFeaturedListings   Int   @default(0)
  /// Discount % applied for normal listing creation when out of quota (0-100)
  listingDiscountPercent Float @default(0)
  /// Discount % applied when dealer requests a featured boost (0–100)
  boostDiscountPercent   Float @default(0)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions DealerSubscription[]

  @@map("dealer_subscription_plans")
}

/// A dealer's active (or historical) subscription to a DealerSubscriptionPlan
model DealerSubscription {
  id       String                 @id @default(cuid())
  dealerId String
  dealer   User                   @relation("DealerSubscriptions", fields: [dealerId], references: [id])
  planId   String
  plan     DealerSubscriptionPlan @relation(fields: [planId], references: [id])

  startDate DateTime
  endDate   DateTime

  paymentStatus         DealerSubPaymentStatus @default(PENDING)
  stripePaymentIntentId String?
  stripeSessionId       String?                @unique
  paidAmount            Float?

  /// Set when super-admin assigns plan directly (bypasses Stripe)
  assignedByAdminId String?
  assignedByAdmin   User?   @relation("AssignedDealerSubscriptions", fields: [assignedByAdminId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("dealer_subscriptions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Invoices
// ─────────────────────────────────────────────────────────────────────────────

/// One common, Qatar-formatted invoice/receipt record for every billable action in the
/// app — a listing publication payment, a featured-listing boost, or a dealer subscription
/// plan purchase. Generated automatically the moment each of those actions completes
/// (whether actually charged via Stripe, or covered by free quota / a full discount /
/// an admin grant), so every account has one continuous, sequentially-numbered billing
/// history behind a single common API regardless of which of the three flows it came from.
model Invoice {
  id            String        @id @default(cuid())
  /// Sequential, gapless, year-scoped — e.g. "INV-2026-000123"
  invoiceNumber String        @unique
  type          InvoiceType
  status        InvoiceStatus @default(PAID)

  /// The account being billed — a USER, or a DEALER (dealer-staff actions are billed to
  /// their parent dealer, since quota/payment is always drawn from the dealer's account)
  billedToId          String
  billedTo            User    @relation("InvoicesBilledTo", fields: [billedToId], references: [id])
  /// Snapshot of the buyer's details at invoice time (kept even if the account is edited later)
  billedToName        String
  billedToEmail       String?
  billedToPhone       String?
  /// Set only when billedTo is a DEALER
  billedToCompany     String?
  billedToTradeNumber String?
  billedToAddress     String?

  /// Invoice title, e.g. "Featured Listing — The Pearl Villa"
  description String
  /// Structured breakdown for frontend receipt rendering: [{ description, quantity, unitPrice, amount }]
  lineItems   Json

  /// id of the Listing / FeaturedSubscription / DealerSubscription this invoice documents
  referenceId String

  subtotal      Float
  vatRate       Float     @default(0)
  vatAmount     Float     @default(0)
  totalAmount   Float
  currency      String    @default("QAR")
  paymentMethod String    @default("Stripe")
  paidAt        DateTime?

  /// MinIO object key of the generated PDF (same file served by the download endpoint and
  /// attached to the invoice email)
  pdfObjectKey String?
  emailedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([billedToId])
  @@index([type])
  @@index([referenceId])
  @@map("invoices")
}

