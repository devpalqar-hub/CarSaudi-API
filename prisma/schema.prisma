// Wishlists
// ─────────────────────────────────────────────────────────────────────────────

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@map("wishlists")
}

// ─────────────────────────────────────────────────────────────────────────────
// Property Visits
// ─────────────────────────────────────────────────────────────────────────────

model PropertyVisit {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  visitorId String
  visitor   User    @relation("VisitVisitor", fields: [visitorId], references: [id], onDelete: Cascade)
  ownerId   String
  owner     User    @relation("VisitOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  scheduledAt DateTime
  proposedAt  DateTime? // For reconfirmation
  status      VisitStatus @default(PENDING)
  notes       String?     @db.Text

